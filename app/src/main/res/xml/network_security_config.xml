<?xml version="1.0" encoding="utf-8"?>
<!--
  Neden cleartext (HTTP) açık?
  IPTV/Xtream sunucularının ve yayın adreslerinin çoğu http:// kullanır ve liste adreslerini kullanıcı
  girdiği için alan adları önceden bilinemez. Bu yüzden genel kural HTTP'ye ve kullanıcının cihaza
  yüklediği sertifikalara izin verir (IPTV davranışı değişmez).

  Uygulamanın kendi API servisleri (TMDB, Gemini, Google, RevenueCat) her zaman HTTPS kullanır: bu alan
  adlarında yanlışlıkla HTTP kullanılmasın diye HTTP kapalıdır. Sertifika güveni genel kuralla aynıdır
  (sistem + kullanıcı): reklam engelleyici / VPN uygulamaları kendi sertifikalarını kullanıcı sertifikası
  olarak yükler; bunlara güvenilmezse bu kullanıcılarda TMDB afişleri, oyuncu fotoğrafları ve yapay zekâ
  özellikleri çalışmaz.

  image.tmdb.org bilerek listede YOK: IPTV/Xtream sağlayıcıları film ve dizi afişlerini çoğunlukla
  http://image.tmdb.org/... adresiyle verir; burada HTTP kapatılırsa afişler yüklenmez. Bu adres sadece
  herkese açık resim sunar, kimlik bilgisi gönderilmez (TMDB anahtarı yalnızca api.themoviedb.org'a gider).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.themoviedb.org</domain>
        <domain includeSubdomains="false">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="false">www.googleapis.com</domain>
        <domain includeSubdomains="true">revenuecat.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- Geliştirme sırasında (debug) proxy araçlarıyla hata ayıklanabilsin. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
